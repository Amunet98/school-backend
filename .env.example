DATABASE_URL="postgresql://school:school@localhost:5433/school_backend?schema=public"

JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_REFRESH_EXPIRES_IN="30d"

PORT=3000

# Sparrow SMS (https://sparrowsms.com). Leave both empty to use the
# console gateway (logs instead of sending). Setting SPARROW_TOKEN
# activates real delivery — no code change needed.
SPARROW_TOKEN=
SPARROW_IDENTITY=
